# Backend API base URL (the telebirr-miniapp NestJS backend). Required —
# the app throws on any API call until this is set.
VITE_API_BASE_URL=https://api.example.com

# Must match CLIENT_API_KEY on the backend. Required in production builds
# (a console error is logged at startup if it's missing).
VITE_API_KEY=

# Telebirr merchant app id used by the H5 payment bridge. Optional — falls
# back to the default merchant app id used by this project if unset.
VITE_TELEBIRR_MERCHANT_APP_ID=
